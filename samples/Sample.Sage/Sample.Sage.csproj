<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    FOR DEVELOPMENT (same solution): use ProjectReference
    FOR PRODUCTION (separate repo):  use PackageReference instead
    
    Option A - ProjectReference (when in same solution):
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Central.ServiceBus\Central.ServiceBus.csproj" />
  </ItemGroup>

  <!--
    Option B - PackageReference (when in a separate Sage repo):
    <ItemGroup>
      <PackageReference Include="Central.ServiceBus" Version="1.0.0" />
    </ItemGroup>
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

</Project>
