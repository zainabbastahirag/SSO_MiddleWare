        <mxCell id="f-a6i-l" value="Invalid" style="edgeLabel;html=1;fontSize=9;fontColor=#b85450;fontStyle=1;" vertex="1" connectable="0" parent="f-a6i"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Expired → Refresh -->
        <mxCell id="f-expired" value="🔄 Call AG ONE&#xa;POST /api/auth/&#xa;external/validate&#xa;{ userId, token }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1280" y="600" width="155" height="65" as="geometry" />
        </mxCell>
        <mxCell id="f-a6x" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="f-d4" target="f-expired"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-a6x-l" value="Expired" style="edgeLabel;html=1;fontSize=9;fontColor=#6c8ebf;fontStyle=1;" vertex="1" connectable="0" parent="f-a6x"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Refresh result -->
        <mxCell id="f-d5" value="Refresh&#xa;OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1315" y="690" width="85" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f-a7" style="endArrow=block;endFill=1;strokeWidth=1;" edge="1" parent="1" source="f-expired" target="f-d5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="f-rok" value="✅ Update cookie&#xa;Set User, Continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1455" y="695" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="f-a7y" style="endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="f-d5" target="f-rok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-a7y-l" value="Y" style="edgeLabel;html=1;fontSize=9;fontColor=#82b366;fontStyle=1;" vertex="1" connectable="0" parent="f-a7y"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <mxCell id="f-rfail" value="❌ Redirect to&#xa;AG ONE login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1155" y="695" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="f-a7n" style="endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="f-d5" target="f-rfail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-a7n-l" value="N" style="edgeLabel;html=1;fontSize=9;fontColor=#b85450;fontStyle=1;" vertex="1" connectable="0" parent="f-a7n"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Query string note -->
        <mxCell id="f-qs" value="If token from ?token=xxx → after setting cookie,&#xa;redirect to clean URL (removes token from address bar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#9673a6;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="1200" y="760" width="350" height="30" as="geometry" />
        </mxCell>

        <!-- Legend in flow box -->
        <mxCell id="f-legend" value="🟢 Green = Allowed     🔴 Red = Rejected     🟡 Yellow = Decision     🔵 Blue = Action     🟠 Orange = Refresh" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1140" y="810" width="460" height="20" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- BOTTOM: Key Points -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="key-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1120" y="950" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="key-title" value="Key Design Points" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fillColor=#f9a825;strokeColor=none;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="958" width="460" height="25" as="geometry" />
        </mxCell>
        <mxCell id="key-text" value="• ONE middleware file (AgOneSsoMiddleware.cs) — same code in every product&#xa;• AG ONE = IsAgOneGateway: true (no external refresh calls, handles own auth)&#xa;• Products = IsAgOneGateway: false (calls AG ONE API when tokens expire)&#xa;• Token handoff via query string (?token=xxx) — cookies can't cross domains&#xa;• Middleware sets HttpOnly cookie on the product's own domain&#xa;• Refresh uses userId (from custom JWT's &quot;sub&quot; claim) to find Entra ID token in DB&#xa;• /_blazor treated as PublicPath so Blazor Server SignalR gets auth state&#xa;• PublicPaths (e.g. &quot;/&quot;) load for everyone — logged-in users see their identity" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#333333;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1130" y="988" width="480" height="115" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
