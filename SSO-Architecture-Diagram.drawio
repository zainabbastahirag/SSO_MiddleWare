        <!-- ENTRA ID -->
        <!-- ═══════════════════════════════════════════════ -->
        <mxCell id="entra" value="Microsoft Entra ID&#xa;(Azure AD)&#xa;&#xa;• OAuth 2.0 / OIDC&#xa;• Issues Access + Refresh Tokens&#xa;• Signing Keys (JWKS)" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
