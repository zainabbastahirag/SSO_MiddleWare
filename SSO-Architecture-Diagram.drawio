        <mxCell id="f-a6v-l" value="Valid" style="edgeLabel;html=1;fontSize=9;fontColor=#82b366;fontStyle=1;" vertex="1" connectable="0" parent="f-a6v"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Expiring -->
        <mxCell id="f-expiring" value="⏳ Proactive refresh&#xa;(continue even if fails)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1475" y="590" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="f-a6e" style="endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="f-d4" target="f-expiring"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f-a6e-l" value="Expiring" style="edgeLabel;html=1;fontSize=9;fontColor=#d6b656;fontStyle=1;" vertex="1" connectable="0" parent="f-a6e"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Invalid -->
        <mxCell id="f-invalid" value="❌ REJECT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
