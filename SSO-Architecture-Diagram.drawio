        <mxCell id="title" value="AG ONE — Single Sign-On (SSO) Architecture" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
