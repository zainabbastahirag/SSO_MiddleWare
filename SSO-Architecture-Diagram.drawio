        <mxCell id="agone-title" value="AG ONE — Central Gateway" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#6c8ebf;strokeColor=#3a6ea5;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- SSO Middleware (AG ONE) -->
        <mxCell id="agone-mw" value="AgOneSsoMiddleware&#xa;(IsAgOneGateway = true)&#xa;&#xa;• Validates JWT from cookie&#xa;• Sets HttpContext.User&#xa;• Does NOT call external refresh&#xa;• PublicPaths: [&quot;/&quot;]&#xa;• AnonymousPaths: /login,&#xa;  /api/auth/*, /api/productlaunch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="135" width="230" height="150" as="geometry" />
        </mxCell>

        <!-- Token DB -->
        <mxCell id="db" value="SQL Database&#xa;(UserTokens)&#xa;&#xa;• UserId&#xa;• AccessToken (Entra ID)&#xa;• RefreshToken&#xa;• ExpiresUtc&#xa;• TenantId" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="170" height="140" as="geometry" />
        </mxCell>

        <!-- Product Launcher -->
        <mxCell id="launcher" value="Product Launcher&#xa;&#xa;GET /api/productlaunch/&#xa;      launch/{code}?token=xxx&#xa;&#xa;→ 302 Redirect to Product URL&#xa;   with ?token=eyJhbG..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="460" width="220" height="115" as="geometry" />
        </mxCell>

        <!-- Refresh API -->
        <mxCell id="refresh-api" value="Token Refresh API&#xa;&#xa;POST /api/auth/external/validate&#xa;{ userId, tenantId, token }&#xa;&#xa;→ Lookup by UserId&#xa;→ Refresh via Entra ID if expired&#xa;→ Return { token: &quot;new...&quot; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="300" width="225" height="130" as="geometry" />
        </mxCell>

        <!-- Entra ID login label  -->
        <mxCell id="agone-login" value="Entra ID Login&#xa;&#xa;• /api/auth/login&#xa;• /api/auth/callback&#xa;• Saves tokens to DB&#xa;• Generates custom JWT (HS256)&#xa;  with sub, email, role&#xa;• Stores in LocalStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="135" width="195" height="140" as="geometry" />
        </mxCell>

