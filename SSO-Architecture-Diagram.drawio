        </mxCell>
        <mxCell id="line-product" style="endArrow=none;strokeColor=#28a745;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="700" y="115" as="sourcePoint" /><mxPoint x="700" y="1350" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="line-entra" style="endArrow=none;strokeColor=#9673a6;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="980" y="115" as="sourcePoint" /><mxPoint x="980" y="1350" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ═══ STEP 1: Login ═══ -->
        <mxCell id="s1-label" value="① User logs into AG ONE" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="220" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s1-arrow1" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="180" as="sourcePoint" /><mxPoint x="415" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s1-arrow1-label" value="Open AG ONE login page" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s1-arrow1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="s1-arrow2" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="425" y="210" as="sourcePoint" /><mxPoint x="975" y="210" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s1-arrow2-label" value="Redirect to Entra ID login" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s1-arrow2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="s1-arrow3" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="975" y="240" as="sourcePoint" /><mxPoint x="425" y="240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s1-arrow3-label" value="Return Access Token + Refresh Token" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s1-arrow3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ═══ STEP 2: Save Token ═══ -->
        <mxCell id="s2-label" value="② AG ONE saves tokens in DB + generates custom JWT" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s2-box" value="AG ONE saves to DB:&#xa;• AccessToken (Entra ID RS256)&#xa;• RefreshToken&#xa;• UserId, TenantId&#xa;&#xa;AG ONE generates custom JWT (HS256):&#xa;• sub=userId, email, role&#xa;• Stored in browser LocalStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="315" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- ═══ STEP 3: Launch Product ═══ -->
        <mxCell id="s3-label" value="③ User clicks 'Launch AG ONE Work'" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="470" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s3-arrow1" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="510" as="sourcePoint" /><mxPoint x="415" y="510" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3-arrow1-label" value="GET /api/productlaunch/launch/AGOneWork?token=eyJ..." style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s3-arrow1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="s3-arrow2" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="415" y="545" as="sourcePoint" /><mxPoint x="145" y="545" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s3-arrow2-label" value="302 Redirect → https://agonework.com?token=eyJ..." style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#28a745;" vertex="1" connectable="0" parent="s3-arrow2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ═══ STEP 4: Middleware on Product ═══ -->
        <mxCell id="s4-label" value="④ SSO Middleware on Product App handles the request" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="585" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s4-arrow1" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="625" as="sourcePoint" /><mxPoint x="695" y="625" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s4-arrow1-label" value="GET https://agonework.com?token=eyJ..." style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s4-arrow1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s4-box" value="Middleware runs:&#xa;1. Extracts ?token=eyJ... from URL&#xa;2. Parses JWT → gets claims (sub, email, role)&#xa;3. Sets HttpContext.User&#xa;4. Sets HttpOnly cookie: agone_sso_token&#xa;5. Redirects to clean URL (removes token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#28a745;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="650" width="275" height="105" as="geometry" />
        </mxCell>

        <mxCell id="s4-arrow2" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="695" y="770" as="sourcePoint" /><mxPoint x="145" y="770" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s4-arrow2-label" value="302 Redirect → https://agonework.com (clean URL)&#xa;+ Set-Cookie: agone_sso_token=eyJ..." style="edgeLabel;html=1;fontSize=10;fontColor=#28a745;fontStyle=1;" vertex="1" connectable="0" parent="s4-arrow2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ═══ STEP 5: Subsequent Requests ═══ -->
        <mxCell id="s5-label" value="⑤ Subsequent requests — cookie sent automatically" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="810" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s5-arrow1" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="855" as="sourcePoint" /><mxPoint x="695" y="855" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s5-arrow1-label" value="Any request + Cookie: agone_sso_token=eyJ..." style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s5-arrow1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="s5-box" value="Middleware: cookie → validate → set User → continue ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#28a745;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="870" width="275" height="30" as="geometry" />
        </mxCell>

        <!-- ═══ STEP 6: Token Refresh ═══ -->
        <mxCell id="s6-label" value="⑥ Token expired — middleware calls AG ONE to refresh" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="930" width="420" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s6-arrow1" style="endArrow=block;endFill=1;strokeColor=#d4a017;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="695" y="975" as="sourcePoint" /><mxPoint x="425" y="975" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s6-arrow1-label" value="POST /api/auth/external/validate&#xa;{ userId: &quot;6ce6...&quot;, token: &quot;eyJ...&quot; }" style="edgeLabel;html=1;fontSize=10;fontColor=#d4a017;" vertex="1" connectable="0" parent="s6-arrow1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s6-box" value="AG ONE: Lookup UserTokens by UserId&#xa;→ Check if Entra ID token expired&#xa;→ If yes, refresh via Entra ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="1000" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s6-arrow2" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="425" y="1075" as="sourcePoint" /><mxPoint x="975" y="1075" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s6-arrow2-label" value="POST /oauth2/v2.0/token (refresh_token grant + client_secret)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s6-arrow2">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s6-arrow3" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="975" y="1105" as="sourcePoint" /><mxPoint x="425" y="1105" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s6-arrow3-label" value="New Access Token + Refresh Token" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="s6-arrow3">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s6-arrow4" style="endArrow=block;endFill=1;strokeColor=#28a745;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="425" y="1140" as="sourcePoint" /><mxPoint x="695" y="1140" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s6-arrow4-label" value="{ token: &quot;new_access_token&quot; }" style="edgeLabel;html=1;fontSize=10;fontColor=#28a745;fontStyle=1;" vertex="1" connectable="0" parent="s6-arrow4">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s6-result" value="Middleware: updates cookie with new token → continues ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#28a745;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="1160" width="275" height="30" as="geometry" />
        </mxCell>

        <!-- ═══ STEP 7: No Token ═══ -->
        <mxCell id="s7-label" value="⑦ No token / refresh fails → redirect to AG ONE login" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=#fff9c4;strokeColor=#f9a825;rounded=1;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="1220" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s7-arrow1" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="695" y="1265" as="sourcePoint" /><mxPoint x="145" y="1265" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s7-arrow1-label" value="302 Redirect → https://agone.com?returnUrl=https://agonework.com/page" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" connectable="0" parent="s7-arrow1">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="s7-note" value="For API calls (AJAX): returns 401 JSON instead of redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="1290" width="380" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- PAGE 3: MIDDLEWARE DECISION FLOWCHART -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <diagram id="middleware-flow" name="Middleware Decision Flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="m-title" value="AgOneSsoMiddleware — Decision Flowchart" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="m-start" value="HTTP Request Arrives" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3a6ea5;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Static file? -->
        <mxCell id="m-d1" value="Static file?&#xa;(.js .css .wasm .dll .ico)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="170" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-a1" style="endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="m-start" target="m-d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-skip1" value="Skip ✓&#xa;(serve file)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="185" width="100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="m-a1y" style="endArrow=block;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="m-d1" target="m-skip1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a1y-label" value="Yes" style="edgeLabel;html=1;fontSize=10;fontColor=#82b366;fontStyle=1;" vertex="1" connectable="0" parent="m-a1y"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Decision: Anonymous path? -->
        <mxCell id="m-d2" value="AnonymousPaths?&#xa;(/login, /api/auth/callback...)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="290" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-a2" style="endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="m-d1" target="m-d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a2-label" value="No" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" vertex="1" connectable="0" parent="m-a2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="m-skip2" value="Skip ✓&#xa;(no auth check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="305" width="100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="m-a2y" style="endArrow=block;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="m-d2" target="m-skip2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a2y-label" value="Yes" style="edgeLabel;html=1;fontSize=10;fontColor=#82b366;fontStyle=1;" vertex="1" connectable="0" parent="m-a2y"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Extract Token -->
        <mxCell id="m-extract" value="Extract Token from:&#xa;1. Authorization: Bearer&#xa;2. Cookie: agone_sso_token&#xa;3. Query: ?token=xxx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="410" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m-a3" style="endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="m-d2" target="m-extract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a3-label" value="No" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" vertex="1" connectable="0" parent="m-a3"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Decision: Token found? -->
        <mxCell id="m-d3" value="Token found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="520" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m-a4" style="endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="m-extract" target="m-d3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- No token -->
        <mxCell id="m-d3a" value="PublicPath?&#xa;(/, /_blazor)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="520" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m-a4n" style="endArrow=block;endFill=1;strokeWidth=1;strokeColor=#b85450;" edge="1" parent="1" source="m-d3" target="m-d3a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a4n-label" value="No token" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" connectable="0" parent="m-a4n"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <mxCell id="m-continue-anon" value="Continue as&#xa;anonymous ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="460" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m-a4n-pub" style="endArrow=block;endFill=1;strokeWidth=1;strokeColor=#82b366;" edge="1" parent="1" source="m-d3a" target="m-continue-anon"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a4n-pub-label" value="Yes" style="edgeLabel;html=1;fontSize=10;fontColor=#82b366;fontStyle=1;" vertex="1" connectable="0" parent="m-a4n-pub"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <mxCell id="m-reject1" value="REJECT&#xa;API → 401 JSON&#xa;Page → Redirect&#xa;to AG ONE login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="600" width="120" height="65" as="geometry" />
        </mxCell>
        <mxCell id="m-a4n-rej" style="endArrow=block;endFill=1;strokeWidth=1;strokeColor=#b85450;" edge="1" parent="1" source="m-d3a" target="m-reject1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a4n-rej-label" value="No" style="edgeLabel;html=1;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" connectable="0" parent="m-a4n-rej"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Validate JWT -->
        <mxCell id="m-validate" value="Validate JWT&#xa;(parse claims, check expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="m-a5" style="endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="m-d3" target="m-validate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="m-a5-label" value="Yes" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" vertex="1" connectable="0" parent="m-a5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>

        <!-- Decision: Token status -->
        <mxCell id="m-d4" value="Token Status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="700" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m-a6" style="endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="m-validate" target="m-d4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Valid -->
        <mxCell id="m-valid" value="✅ Set User +&#xa;Set Cookie +&#xa;Continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="700" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="m-a6v" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="m-d4" target="m-valid"><mxGeometry relative="1" as="geometry" /></mxCell>
