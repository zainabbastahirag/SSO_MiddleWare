        <!-- Validate -->
        <mxCell id="f-validate" value="Validate JWT&#xa;(parse claims, check exp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
