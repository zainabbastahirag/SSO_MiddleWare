        <!-- SSO Middleware (AG ONE) -->
        <mxCell id="agone-mw" value="🛡️ AgOneSsoMiddleware&#xa;(IsAgOneGateway = true)&#xa;&#xa;• Validates JWT from cookie&#xa;• Sets HttpContext.User&#xa;• Skips external refresh&#xa;• AnonymousPaths: /login,&#xa;  /api/auth/*, /api/productlaunch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=11;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="285" width="250" height="145" as="geometry" />
        </mxCell>

