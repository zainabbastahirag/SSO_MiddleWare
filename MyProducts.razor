    .product-actions .btn-primary, .product-actions .btn-outline { flex: 1; }
    .btn-outline.full-width { width: 100%; justify-content: center; }
</style>

@code {
    private List<SubscriptionViewModel> _activeSubscriptions = new();
    private List<ProductViewModel> _availableProducts = new();
    private IEnumerable<string>? _userRoles;
    private List<Guid> _subscribedProductIds = new();
    private bool _isPlatformLevel = false;
    private UserDto? currentUser;
    private bool _isMGateUser = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();

            var allowedMGateUserIds = await SettingsService.GetMGateAllowedUserIdsAsync();
            var currentUserId = currentUser?.Id.ToString().ToUpperInvariant() ?? "";
            _isMGateUser = allowedMGateUserIds.Any(id => id.ToUpperInvariant() == currentUserId);

            _userRoles = currentUser?.Roles ?? new List<string>();
            _isPlatformLevel = AuthorizationService.CanSeeAllProducts(_userRoles);

            var products = await ProductService.GetAllAsync();
            var subscriptions = await SubscriptionService.GetMySubscriptionsAsync();

            _subscribedProductIds = subscriptions.Select(s => s.ProductId).ToList();

            ProcessData(products, subscriptions);
        }
        catch (Exception ex)
        {
            LoadSampleData();
        }
    }

    private void ProcessData(List<ProductDto> products, List<SubscriptionDto> subscriptions)
    {
        var activeSubProductIds = new HashSet<Guid>();

        foreach (var sub in subscriptions.Where(s => s.Status == "Active"))
        {
            activeSubProductIds.Add(sub.ProductId);
            var product = products.FirstOrDefault(p => p.Id == sub.ProductId);

            _activeSubscriptions.Add(new SubscriptionViewModel
            {
                SubscriptionId = sub.Id,
                ProductId = sub.ProductId,
                ProductCode = product?.Code ?? "",
                ProductName = sub.ProductName ?? product?.Name ?? "Product",
                Description = product?.ShortDescription ?? "Product description",
                PlanName = sub.PlanName ?? "Standard",
                UsedLicenses = sub.UsedLicenses,
                MaxLicenses = sub.MaxLicenses,
                NextBilling = sub.EndDate?.ToString("MMM dd, yyyy") ?? "N/A",
                Initial = (product?.Name ?? "P").Substring(0, 1),
                ColorClass = GetColorClass(product?.Code ?? "")
            });
        }

        if (_isPlatformLevel || AuthorizationService.IsTenantAdmin(_userRoles))
        {
            foreach (var product in products.Where(p => !activeSubProductIds.Contains(p.Id)))
            {
                _availableProducts.Add(new ProductViewModel
                {
                    Id = product.Id,
                    Code = product.Code ?? "",
                    Name = product.Name,
                    Description = product.ShortDescription ?? "Product description",
                    Price = $"{product.StartingPrice:F2}",
                    Initial = product.Name.Substring(0, 1),
                    ColorClass = GetColorClass(product.Code ?? ""),
                    Tags = ParseTags(product.Tags)
                });
            }
        }
    }

    private void LoadSampleData()
    {
        _activeSubscriptions = new List<SubscriptionViewModel>
        {
            new() { SubscriptionId = Guid.NewGuid(), ProductId = Guid.NewGuid(), ProductCode = "AGONEANALYTICS", ProductName = "AG ONE Analytics", Description = "Employee Management & Collaborative tools", PlanName = "Professional", UsedLicenses = 35, MaxLicenses = 50, NextBilling = DateTime.Now.AddMonths(3).ToString("MMM dd, yyyy"), Initial = "A", ColorClass = "bg-blue" },
            new() { SubscriptionId = Guid.NewGuid(), ProductId = Guid.NewGuid(), ProductCode = "AGONESPOTCITY", ProductName = "AG ONE SPOT - City", Description = "Finance AI Report Generation & Analytics", PlanName = "Enterprise", UsedLicenses = 85, MaxLicenses = 200, NextBilling = DateTime.Now.AddMonths(6).ToString("MMM dd, yyyy"), Initial = "S", ColorClass = "bg-purple" },
            new() { SubscriptionId = Guid.NewGuid(), ProductId = Guid.NewGuid(), ProductCode = "AGONESENTIMENTCITY", ProductName = "AG Sentiment", Description = "Security, Data Library & Compliance Platform", PlanName = "Standard", UsedLicenses = 20, MaxLicenses = 100, NextBilling = DateTime.Now.AddMonths(1).ToString("MMM dd, yyyy"), Initial = "S", ColorClass = "bg-green" },
            new() { SubscriptionId = Guid.NewGuid(), ProductId = Guid.NewGuid(), ProductCode = "PLANVIEW", ProductName = "Planview", Description = "Learning Centre & Course Management", PlanName = "Professional", UsedLicenses = 45, MaxLicenses = 75, NextBilling = DateTime.Now.AddMonths(2).ToString("MMM dd, yyyy"), Initial = "P", ColorClass = "bg-orange" },
            new() { SubscriptionId = Guid.NewGuid(), ProductId = Guid.NewGuid(), ProductCode = "AGONESPOTLANDMANAGEMENT", ProductName = "AG ONE Spot - Land Management", Description = "Learning Centre & Course Management", PlanName = "Standard", UsedLicenses = 10, MaxLicenses = 50, NextBilling = DateTime.Now.AddMonths(4).ToString("MMM dd, yyyy"), Initial = "L", ColorClass = "bg-blue" }
        };
    }

    private string GetColorClass(string code)
    {
        if (code.Contains("Learn")) return "bg-blue";
        if (code.Contains("Odela")) return "bg-purple";
        if (code.Contains("HR")) return "bg-green";
        if (code.Contains("Analytics") || code.Contains("ANALYTICS")) return "bg-orange";
        if (code.Contains("SPOT") || code.Contains("SENTIMENT") || code.Contains("PLANVIEW")) return "bg-blue";
        return "bg-blue";
    }

    private List<string> ParseTags(string? tags)
    {
        if (string.IsNullOrEmpty(tags)) return new();
        return tags.Split(',').Take(3).Select(t => t.Trim()).ToList();
    }

    private async Task LaunchProductAsync(string code) => await ProductLaunchService.LaunchProductAsync(code);
    private async Task LaunchProductInNewTabAsync(string code) => await ProductLaunchService.LaunchProductInNewTabAsync(code);
    private void ManageSubscription(Guid subscriptionId) => Navigation.NavigateTo("/admin/subscriptions/" + subscriptionId);

    private string? GetProductLogo(string code)
    {
        if (string.IsNullOrEmpty(code)) return null;
        return code.ToUpperInvariant() switch
        {
            "AGONEANALYTICS" or "AGONE_ANALYTICS" or "ANALYTICS" => "/images/logos/mgate-logo-analytics.png",
            "AGONESPOTCITY" or "SPOTCITY" => "/images/logos/mgate-logo-spotcity.png",
            "AGONESENTIMENTCITY" or "SENTIMENTCITY" => "/images/logos/mgate-logo-sentimentcity.png",
            "AGONESPOTLANDMANAGEMENT" or "SPOTLAND" => "/images/logos/mgate-logo-spotland.png",
            "PLANVIEW" => "/images/logos/mgate-logo-planview.png",
            _ => null
        };
    }

    public class SubscriptionViewModel
    {
        public Guid SubscriptionId { get; set; }
        public Guid ProductId { get; set; }
        public string ProductCode { get; set; } = "";
        public string ProductName { get; set; } = "";
        public string Description { get; set; } = "";
        public string PlanName { get; set; } = "";
        public int UsedLicenses { get; set; }
        public int MaxLicenses { get; set; }
        public string NextBilling { get; set; } = "";
        public string Initial { get; set; } = "";
        public string ColorClass { get; set; } = "";
        public int UsagePercent => MaxLicenses == 0 ? 0 : UsedLicenses * 100 / MaxLicenses;
        public string UsageColor => UsagePercent < 70 ? "green" : UsagePercent < 90 ? "yellow" : "red";
    }

    public class ProductViewModel
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Price { get; set; } = "";
        public string Initial { get; set; } = "";
        public string ColorClass { get; set; } = "";
        public List<string> Tags { get; set; } = new();
    }
}
