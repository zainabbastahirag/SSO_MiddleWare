@page "/admin/users"
@layout AdminLayout
@inject IUserService UserService
@inject ISubscriptionService SubscriptionService
@inject IRoleService RoleService
@inject IAuthService AuthService
@inject ISnackbar Snackbar

<PageTitle>User Management - AGOne</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">User Management</h1>
            <p class="page-subtitle">Manage users for your subscribed products</p>
        </div>
        <button class="btn-primary" @onclick="OpenCreateDialog">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/>
            </svg>
            Invite User
        </button>
    </div>

    <!-- Quick Stats -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-icon users">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_users.Count</span>
                <span class="stat-label">Total Users</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon active">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><polyline points="9 12 12 15 16 10"/>
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_users.Count(u => u.IsActive)</span>
                <span class="stat-label">Active</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon products">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m7.5 4.27 9 5.15"/>
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_subscribedProducts.Count</span>
                <span class="stat-label">Subscribed Products</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon pending">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_users.Count(u => !u.IsActive)</span>
                <span class="stat-label">Pending Invites</span>
            </div>
        </div>
    </div>

    <!-- Filter by Product -->
    <div class="product-filter">
        <span class="filter-label">Filter by Product:</span>
        <div class="product-pills">
            <button class="product-pill @(_selectedProductFilter == null ? "active" : "")"
                    @onclick="() => FilterByProduct(null)">
                All Products
            </button>
            @foreach (var product in _subscribedProducts)
            {
                <button class="product-pill @(_selectedProductFilter == product.Id ? "active" : "")"
                        @onclick="() => FilterByProduct(product.Id)">
                    @product.Name
                    <span class="pill-count">@GetUserCountForProduct(product.Id)</span>
                </button>
            }
        </div>
    </div>

    <!-- Users Table -->
    <div class="card">
        <div class="card-header">
            <div class="search-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                </svg>
                <input type="text" placeholder="Search users..." @bind="_searchTerm" @bind:event="oninput" />
            </div>
            <div class="filter-actions">
                <select @bind="_roleFilter">
                    <option value="">All Roles</option>
                    @foreach (var role in _availableRoles)
                    {
                        <option value="@role.Name">@role.DisplayName</option>
                    }
                </select>
            </div>
        </div>

        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Product Access</th>
                        <th>Status</th>
                        <th>Last Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredUsers.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; padding:40px; color:#6B7280;">
                                No users found
                            </td>
                        </tr>
                    }
                    @foreach (var user in FilteredUsers)
                    {
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar" style="background: @GetAvatarColor(user.Email ?? "")">
                                        @GetInitials(user.FirstName, user.LastName)
                                    </div>
                                    <div>
                                        <div class="user-name">@GetFullName(user.FirstName, user.LastName)</div>
                                        <div class="user-email">@(user.Email ?? "No email")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="role-badge @GetRoleClass(GetFirstRole(user))">@GetFirstRole(user)</span>
                            </td>
                            <td>
                                <div class="product-access">
                                    @if (user.AssignedProductIds?.Any() == true)
                                    {
                                        @foreach (var productId in user.AssignedProductIds.Take(2))
                                        {
                                            var productName = _subscribedProducts.FirstOrDefault(p => p.Id == productId)?.Name ?? productId.ToString()[..8];
                                            <span class="product-tag">@productName</span>
                                        }
                                        @if (user.AssignedProductIds.Count > 2)
                                        {
                                            <span class="product-tag more">+@(user.AssignedProductIds.Count - 2)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="product-tag" style="background:#F3F4F6;color:#9CA3AF;">None</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(user.Email))
                                {
                                    <span class="status-badge no-email">No Email</span>
                                }
                                else if (!user.IsActive)
                                {
                                    <span class="status-badge pending">Pending</span>
                                }
                                else
                                {
                                    <span class="status-badge active">Active</span>
                                }
                            </td>
                            <td>
                                <span class="last-active">@FormatLastActive(user.LastLoginAt)</span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    @* ── Invite button: only for users with no email ── *@
                                    @if (string.IsNullOrEmpty(user.Email))
                                    {
                                        <button class="invite-row-btn" title="Send Invite" @onclick="() => OpenInviteForUser(user)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/>
                                                <path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"/>
                                            </svg>
                                            Invite
                                        </button>
                                    }

                                    <button class="icon-btn" title="Edit" @onclick="() => EditUser(user)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                        </svg>
                                    </button>

                                    @* ── Resend invite: only for pending (has email but not active) ── *@
                                    @if (!string.IsNullOrEmpty(user.Email) && !user.IsActive)
                                    {
                                        <button class="icon-btn" title="Resend Invite" @onclick="() => ResendInvite(user)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/>
                                                <path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"/>
                                            </svg>
                                        </button>
                                    }

                                    <button class="icon-btn danger" title="Remove" @onclick="() => ConfirmRemoveUser(user)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ═══════════ Invite / Edit User Dialog ═══════════ -->
@if (_showInviteDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@GetDialogTitle()</h2>
                <button class="close-btn" @onclick="CloseDialog">&times;</button>
            </div>
            <div class="modal-body">
                <div class="invite-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
                    </svg>
                    <p>
                        @if (_editingUser != null && string.IsNullOrEmpty(_editingUser.Email))
                        {
                            <text>Enter an email address to send an invitation to this user.</text>
                        }
                        else if (_editingUser != null)
                        {
                            <text>Update user details and product access.</text>
                        }
                        else
                        {
                            <text>User will receive an email invitation to join your organization and access selected products.</text>
                        }
                    </p>
                </div>

                <div class="form-group">
                    <label>Email Address *</label>
                    <input type="email" @bind="_inviteEmail" placeholder="user@company.com" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" @bind="_inviteFirstName" placeholder="John" />
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" @bind="_inviteLastName" placeholder="Doe" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Product Access *</label>
                    <p class="form-hint">Select which products this user can access</p>
                    <div class="product-selection">
                        @foreach (var product in _subscribedProducts)
                        {
                            <label class="product-option @(_selectedProductsForInvite.Contains(product.Id) ? "selected" : "")">
                                <input type="checkbox"
                                       checked="@_selectedProductsForInvite.Contains(product.Id)"
                                       @onchange="() => ToggleProductSelection(product.Id)" />
                                <div class="product-option-content">
                                    <div class="product-icon" style="background: @GetProductColor(product.Name)">
                                        @product.Name[0]
                                    </div>
                                    <div>
                                        <span class="product-name">@product.Name</span>
                                        <span class="product-desc">@product.ShortDescription</span>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                @if (_selectedProductsForInvite.Any())
                {
                    <div class="form-group">
                        <label>Product-Specific Permissions</label>
                        <div class="product-permissions">
                            @foreach (var productId in _selectedProductsForInvite)
                            {
                                var product = _subscribedProducts.FirstOrDefault(p => p.Id == productId);
                                if (product != null)
                                {
                                    <div class="permission-row">
                                        <span class="perm-product-name">@product.Name</span>
                                        <select value="@GetPermission(productId)" @onchange="e => SetPermission(productId, e.Value?.ToString() ?? "user")">
                                            <option value="viewer">Viewer - Read only</option>
                                            <option value="user">User - Standard access</option>
                                            <option value="manager">Manager - Manage content</option>
                                            <option value="admin">Admin - Full access</option>
                                        </select>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="CloseDialog">Cancel</button>
                <button class="btn-primary" @onclick="SendInvite" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/>
                            <path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"/>
                        </svg>
                    }
                    @GetSubmitButtonText()
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══════════ Confirm Remove Dialog ═══════════ -->
@if (_showRemoveConfirm)
{
    <div class="modal-overlay" @onclick="() => _showRemoveConfirm = false">
        <div class="modal-content confirm-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Remove User</h2>
                <button class="close-btn" @onclick="() => _showRemoveConfirm = false">&times;</button>
            </div>
            <div class="modal-body" style="text-align:center; padding:32px 24px;">
                <div style="width:56px;height:56px;border-radius:50%;background:#FEE2E2;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2">
                        <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                    </svg>
                </div>
                <p style="font-size:15px;color:#374151;margin-bottom:4px;">
                    Are you sure you want to remove <strong>@GetFullName(_userToRemove?.FirstName, _userToRemove?.LastName)</strong>?
                </p>
                <p style="font-size:13px;color:#6B7280;">This action cannot be undone.</p>
            </div>
            <div class="modal-footer" style="justify-content:center;">
                <button class="btn-outline" @onclick="() => _showRemoveConfirm = false">Cancel</button>
                <button class="btn-danger" @onclick="RemoveUserConfirmed">Remove User</button>
            </div>
        </div>
    </div>
}

<style>
    .page-container { padding: 0; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .page-title { font-size: 28px; font-weight: 700; color: #111827; margin-bottom: 4px; }
    .page-subtitle { font-size: 14px; color: #6B7280; }

    .btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: linear-gradient(135deg, #3B82F6, #8B5CF6); border: none; border-radius: 8px; color: white; font-weight: 500; cursor: pointer; font-size: 14px; transition: opacity 0.2s; }
    .btn-primary:hover { opacity: 0.9; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-outline { padding: 10px 20px; background: white; border: 1px solid #E5E7EB; border-radius: 8px; color: #374151; font-weight: 500; cursor: pointer; font-size: 14px; }
    .btn-outline:hover { background: #F9FAFB; }
    .btn-danger { padding: 10px 20px; background: #DC2626; border: none; border-radius: 8px; color: white; font-weight: 500; cursor: pointer; font-size: 14px; }
    .btn-danger:hover { background: #B91C1C; }

    .stats-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: white; border: 1px solid #E5E7EB; border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px; }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
    .stat-icon.users { background: #DBEAFE; color: #2563EB; }
    .stat-icon.active { background: #D1FAE5; color: #059669; }
    .stat-icon.products { background: #EDE9FE; color: #7C3AED; }
    .stat-icon.pending { background: #FEF3C7; color: #D97706; }
    .stat-value { display: block; font-size: 24px; font-weight: 700; color: #111827; }
    .stat-label { font-size: 13px; color: #6B7280; }

    .product-filter { background: white; border: 1px solid #E5E7EB; border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .filter-label { font-size: 14px; font-weight: 500; color: #374151; }
    .product-pills { display: flex; gap: 8px; flex-wrap: wrap; }
    .product-pill { display: flex; align-items: center; gap: 6px; padding: 8px 14px; background: #F3F4F6; border: 1px solid #E5E7EB; border-radius: 9999px; font-size: 13px; color: #374151; cursor: pointer; transition: all 0.2s; }
    .product-pill:hover { border-color: #3B82F6; color: #3B82F6; }
    .product-pill.active { background: linear-gradient(135deg, #3B82F6, #8B5CF6); border-color: transparent; color: white; }
    .pill-count { background: rgba(0,0,0,0.1); padding: 2px 6px; border-radius: 9999px; font-size: 11px; }
    .product-pill.active .pill-count { background: rgba(255,255,255,0.2); }

    .card { background: white; border: 1px solid #E5E7EB; border-radius: 12px; overflow: hidden; }
    .card-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #E5E7EB; gap: 16px; }
    .search-box { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; flex: 1; max-width: 300px; }
    .search-box input { border: none; background: transparent; outline: none; flex: 1; font-size: 14px; }
    .filter-actions select { padding: 8px 12px; border: 1px solid #E5E7EB; border-radius: 8px; font-size: 14px; background: white; }

    .table-container { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th { text-align: left; padding: 12px 16px; background: #F9FAFB; font-size: 12px; font-weight: 600; color: #6B7280; text-transform: uppercase; }
    .data-table td { padding: 16px; border-bottom: 1px solid #E5E7EB; font-size: 14px; }
    .data-table tr:hover { background: #F9FAFB; }

    .user-cell { display: flex; align-items: center; gap: 12px; }
    .user-avatar { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 14px; text-transform: uppercase; }
    .user-name { font-weight: 600; color: #111827; }
    .user-email { font-size: 12px; color: #6B7280; }

    .role-badge { padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 500; }
    .role-badge.admin { background: #DBEAFE; color: #1D4ED8; }
    .role-badge.manager { background: #E0E7FF; color: #4F46E5; }
    .role-badge.user { background: #F3F4F6; color: #374151; }

    .product-access { display: flex; gap: 4px; flex-wrap: wrap; }
    .product-tag { padding: 2px 8px; background: #E0E7FF; color: #4F46E5; border-radius: 4px; font-size: 11px; }
    .product-tag.more { background: #F3F4F6; color: #6B7280; }

    .status-badge { padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 500; }
    .status-badge.active { background: #D1FAE5; color: #065F46; }
    .status-badge.pending { background: #FEF3C7; color: #92400E; }
    .status-badge.no-email { background: #FEE2E2; color: #991B1B; }

    .last-active { font-size: 13px; color: #6B7280; }

    .action-buttons { display: flex; gap: 8px; align-items: center; }
    .icon-btn { padding: 6px; background: transparent; border: 1px solid #E5E7EB; border-radius: 6px; cursor: pointer; color: #6B7280; transition: all 0.2s; display: flex; align-items: center; justify-content: center; }
    .icon-btn:hover { background: #F3F4F6; color: #111827; }
    .icon-btn.danger:hover { background: #FEE2E2; color: #DC2626; border-color: #FECACA; }

    .invite-row-btn { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 6px; color: #2563EB; font-size: 12px; font-weight: 500; cursor: pointer; transition: all 0.2s; }
    .invite-row-btn:hover { background: #DBEAFE; border-color: #93C5FD; }

    /* Modal */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(2px); }
    .modal-content { background: white; border-radius: 12px; width: 100%; max-width: 560px; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.15); }
    .confirm-modal { max-width: 420px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #E5E7EB; }
    .modal-header h2 { font-size: 18px; font-weight: 600; }
    .close-btn { background: none; border: none; font-size: 24px; cursor: pointer; color: #9CA3AF; line-height: 1; }
    .close-btn:hover { color: #374151; }
    .modal-body { padding: 24px; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 12px; padding: 16px 24px; border-top: 1px solid #E5E7EB; }

    .invite-info { display: flex; gap: 12px; padding: 12px 16px; background: #EFF6FF; border-radius: 8px; margin-bottom: 20px; }
    .invite-info svg { color: #3B82F6; flex-shrink: 0; margin-top: 2px; }
    .invite-info p { font-size: 13px; color: #1E40AF; margin: 0; }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 6px; color: #374151; }
    .form-group input, .form-group select { width: 100%; padding: 10px 12px; border: 1px solid #E5E7EB; border-radius: 8px; font-size: 14px; box-sizing: border-box; }
    .form-group input:focus, .form-group select:focus { outline: none; border-color: #3B82F6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    .form-hint { font-size: 12px; color: #6B7280; margin-bottom: 12px; }
    .form-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

    .product-selection { display: flex; flex-direction: column; gap: 8px; }
    .product-option { display: flex; align-items: center; gap: 12px; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px; cursor: pointer; transition: all 0.2s; }
    .product-option:hover { border-color: #3B82F6; }
    .product-option.selected { border-color: #3B82F6; background: #EFF6FF; }
    .product-option input { width: 16px; height: 16px; accent-color: #3B82F6; }
    .product-option-content { display: flex; align-items: center; gap: 12px; flex: 1; }
    .product-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; }
    .product-option .product-name { display: block; font-weight: 500; color: #111827; }
    .product-option .product-desc { display: block; font-size: 12px; color: #6B7280; }

    .product-permissions { display: flex; flex-direction: column; gap: 8px; }
    .permission-row { display: flex; justify-content: space-between; align-items: center; padding: 12px; background: #F9FAFB; border-radius: 8px; }
    .perm-product-name { font-weight: 500; }
    .permission-row select { width: 180px; padding: 6px 10px; border: 1px solid #E5E7EB; border-radius: 6px; font-size: 13px; }

    .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.6s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    @@media (max-width: 768px) {
        .stats-cards { grid-template-columns: repeat(2, 1fr); }
        .form-row { grid-template-columns: 1fr; }
    }
</style>

@code {
    private List<UserDto> _users = new();
    private List<SubscribedProduct> _subscribedProducts = new();
    private List<AvailableRole> _availableRoles = new();

    private string _searchTerm = "";
    private string _roleFilter = "";
    private Guid? _selectedProductFilter;

    // Invite Dialog
    private bool _showInviteDialog;
    private bool _isSaving;
    private UserDto? _editingUser;
    private string _inviteEmail = "";
    private string _inviteFirstName = "";
    private string _inviteLastName = "";
    private HashSet<Guid> _selectedProductsForInvite = new();
    private Dictionary<Guid, string> _productPermissions = new();

    // Remove Confirm
    private bool _showRemoveConfirm;
    private UserDto? _userToRemove;

    private IEnumerable<UserDto> FilteredUsers => _users
        .Where(u => string.IsNullOrEmpty(_searchTerm) ||
                    (u.FirstName ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (u.LastName ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (u.Email ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(u => string.IsNullOrEmpty(_roleFilter) ||
                    (u.Roles?.Any(r => r.Equals(_roleFilter, StringComparison.OrdinalIgnoreCase)) == true))
        .Where(u => _selectedProductFilter == null ||
                    (u.AssignedProductIds?.Contains(_selectedProductFilter.Value) == true))
        .OrderBy(u => u.FirstName ?? "");

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var subscriptions = await SubscriptionService.GetMySubscriptionsAsync();
            _subscribedProducts = subscriptions
                .Where(s => s.Status == "Active")
                .Select(s => new SubscribedProduct
                {
                    Id = s.ProductId,
                    Name = s.ProductName ?? "Product",
                    ShortDescription = "Subscribed product"
                }).ToList();
        }
        catch
        {
            _subscribedProducts = new List<SubscribedProduct>
            {
                new() { Id = Guid.NewGuid(), Name = "AGOne Learn", ShortDescription = "Corporate Learning Platform" },
                new() { Id = Guid.NewGuid(), Name = "AGOne Odela", ShortDescription = "Analytics & Insights" }
            };
        }

        _availableRoles = new List<AvailableRole>
        {
            new() { Name = "TenantManager", DisplayName = "Manager", Description = "Manage users and settings" },
            new() { Name = "ProductAdmin", DisplayName = "Product Admin", Description = "Full product access" },
            new() { Name = "EndUser", DisplayName = "User", Description = "Standard access to products" }
        };

        try
        {
            _users = await UserService.GetAllAsync();
        }
        catch
        {
            _users = new List<UserDto>();
        }
    }

    // ═══════════ Helpers ═══════════

    private void FilterByProduct(Guid? productId) => _selectedProductFilter = productId;

    private int GetUserCountForProduct(Guid productId) =>
        _users.Count(u => u.AssignedProductIds?.Contains(productId) == true);

    private static string GetInitials(string? firstName, string? lastName)
    {
        var f = firstName?.Trim().FirstOrDefault();
        var l = lastName?.Trim().FirstOrDefault();
        if (f != default && l != default) return $"{f}{l}";
        if (f != default) return f.ToString();
        return "?";
    }

    private static string GetFullName(string? firstName, string? lastName)
    {
        var name = $"{firstName} {lastName}".Trim();
        return string.IsNullOrEmpty(name) ? "Unnamed User" : name;
    }

    private static string GetFirstRole(UserDto user)
    {
        if (user.Roles == null || !user.Roles.Any()) return "No Role";
        return user.Roles.First();
    }

    private string GetAvatarColor(string text)
    {
        var colors = new[] { "#3B82F6", "#10B981", "#8B5CF6", "#F59E0B", "#EF4444", "#EC4899" };
        return colors[Math.Abs(text.GetHashCode()) % colors.Length];
    }

    private string GetProductColor(string name)
    {
        var colors = new[] { "#3B82F6", "#10B981", "#8B5CF6", "#F59E0B" };
        return colors[Math.Abs(name.GetHashCode()) % colors.Length];
    }

    private string GetRoleClass(string role) => role switch
    {
        "TenantAdmin" or "TenantManager" => "admin",
        "ProductAdmin" => "manager",
        _ => "user"
    };

    private string FormatLastActive(DateTime? date)
    {
        if (!date.HasValue) return "Never";
        var diff = DateTime.Now - date.Value;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} hours ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} days ago";
        return date.Value.ToString("dd MMM yyyy");
    }

    private string GetPermission(Guid productId)
    {
        return _productPermissions.TryGetValue(productId, out var perm) ? perm : "user";
    }

    private void SetPermission(Guid productId, string permission)
    {
        _productPermissions[productId] = permission;
    }

    private string GetDialogTitle()
    {
        if (_editingUser != null && string.IsNullOrEmpty(_editingUser.Email))
            return $"Invite {GetFullName(_editingUser.FirstName, _editingUser.LastName)}";
        if (_editingUser != null)
            return "Edit User";
        return "Invite New User";
    }

    private string GetSubmitButtonText()
    {
        if (_editingUser != null && string.IsNullOrEmpty(_editingUser.Email))
            return "Send Invitation";
        if (_editingUser != null)
            return "Save Changes";
        return "Send Invitation";
    }

    // ═══════════ Dialog Actions ═══════════

    private void OpenCreateDialog()
    {
        _editingUser = null;
        _inviteEmail = "";
        _inviteFirstName = "";
        _inviteLastName = "";
        _selectedProductsForInvite.Clear();
        _productPermissions.Clear();
        _showInviteDialog = true;
    }

    /// <summary>Opens invite popup pre-filled with user's name (for users without email).</summary>
    private void OpenInviteForUser(UserDto user)
    {
        _editingUser = user;
        _inviteEmail = "";
        _inviteFirstName = user.FirstName ?? "";
        _inviteLastName = user.LastName ?? "";
        _selectedProductsForInvite = new HashSet<Guid>(user.AssignedProductIds ?? new List<Guid>());
        _productPermissions = _selectedProductsForInvite.ToDictionary(id => id, _ => "user");
        _showInviteDialog = true;
    }

    private void EditUser(UserDto user)
    {
        _editingUser = user;
        _inviteEmail = user.Email ?? "";
        _inviteFirstName = user.FirstName ?? "";
        _inviteLastName = user.LastName ?? "";
        _selectedProductsForInvite = new HashSet<Guid>(user.AssignedProductIds ?? new List<Guid>());
        _productPermissions = _selectedProductsForInvite.ToDictionary(id => id, _ => "user");
        _showInviteDialog = true;
    }

    private void CloseDialog()
    {
        _showInviteDialog = false;
        _editingUser = null;
    }

    private void ToggleProductSelection(Guid productId)
    {
        if (_selectedProductsForInvite.Contains(productId))
        {
            _selectedProductsForInvite.Remove(productId);
            _productPermissions.Remove(productId);
        }
        else
        {
            _selectedProductsForInvite.Add(productId);
            _productPermissions[productId] = "user";
        }
    }

    private async Task SendInvite()
    {
        if (string.IsNullOrWhiteSpace(_inviteEmail))
        {
            Snackbar.Add("Please enter an email address", Severity.Warning);
            return;
        }

        if (!_selectedProductsForInvite.Any())
        {
            Snackbar.Add("Please select at least one product", Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            if (_editingUser != null && string.IsNullOrEmpty(_editingUser.Email))
            {
                // Inviting an existing user who had no email
                _editingUser.Email = _inviteEmail;
                _editingUser.FirstName = _inviteFirstName;
                _editingUser.LastName = _inviteLastName;
                _editingUser.AssignedProductIds = _selectedProductsForInvite.ToList();
                // TODO: Call your API to update user and send invite email
                // await UserService.UpdateAndInviteAsync(_editingUser);
                Snackbar.Add($"Invitation sent to {_inviteEmail}", Severity.Success);
            }
            else if (_editingUser != null)
            {
                // Editing an existing user
                _editingUser.FirstName = _inviteFirstName;
                _editingUser.LastName = _inviteLastName;
                _editingUser.Email = _inviteEmail;
                _editingUser.AssignedProductIds = _selectedProductsForInvite.ToList();
                // TODO: Call your API to update user
                // await UserService.UpdateAsync(_editingUser);
                Snackbar.Add("User updated successfully", Severity.Success);
            }
            else
            {
                // Creating a brand new invite
                var newUser = new UserDto
                {
                    Id = Guid.NewGuid(),
                    FirstName = _inviteFirstName,
                    LastName = _inviteLastName,
                    Email = _inviteEmail,
                    IsActive = false,
                    AssignedProductIds = _selectedProductsForInvite.ToList(),
                    ProductRoles = _selectedProductsForInvite
                        .Select(id => _subscribedProducts.FirstOrDefault(p => p.Id == id)?.Name ?? "")
                        .Where(n => !string.IsNullOrEmpty(n))
                        .ToList()
                };
                _users.Add(newUser);
                // TODO: Call your API to create user and send invite email
                // await UserService.InviteAsync(newUser);
                Snackbar.Add($"Invitation sent to {_inviteEmail}", Severity.Success);
            }

            CloseDialog();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResendInvite(UserDto user)
    {
        // TODO: Call your API to resend invite
        // await UserService.ResendInviteAsync(user.Id);
        Snackbar.Add($"Invitation resent to {user.Email}", Severity.Success);
    }

    private void ConfirmRemoveUser(UserDto user)
    {
        _userToRemove = user;
        _showRemoveConfirm = true;
    }

    private void RemoveUserConfirmed()
    {
        if (_userToRemove != null)
        {
            _users.Remove(_userToRemove);
            // TODO: Call your API to remove user
            // await UserService.RemoveAsync(_userToRemove.Id);
            Snackbar.Add($"User {GetFullName(_userToRemove.FirstName, _userToRemove.LastName)} removed", Severity.Info);
        }
        _showRemoveConfirm = false;
        _userToRemove = null;
    }

    // ═══════════ Inner Models ═══════════

    private class SubscribedProduct
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ShortDescription { get; set; } = "";
    }

    private class AvailableRole
    {
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
    }
}
