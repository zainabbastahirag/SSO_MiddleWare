// After builder.Services.AddAgOneSso(builder.Configuration):

// This tells Blazor Server to read auth state from HttpContext.User
// (which the SSO middleware sets from the cookie)
builder.Services.AddScoped<AuthenticationStateProvider, ServerAuthenticationStateProvider>();

