{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "AgOne.Sso": "Debug"
    }
  },

  "AgOneSso": {
    "// REQUIRED — AG ONE Central Gateway URL": "",
    "AgOneBaseUrl": "https://agone.example.com",
    "AgOneLoginUrl": "https://agone.example.com",

    "// REQUIRED — Entra ID settings for JWT validation": "",
    "TenantId": "YOUR-ENTRA-TENANT-ID",
    "ClientId": "YOUR-ENTRA-CLIENT-ID",
    "Authority": "https://login.microsoftonline.com/YOUR-ENTRA-TENANT-ID/v2.0",
    "ValidAudience": "api://YOUR-ENTRA-CLIENT-ID",

    "// Token validation/refresh endpoint on AG ONE": "",
    "TokenValidateEndpoint": "api/auth/external/validate",

    "// Cookie settings": "",
    "SessionCookieName": "agone_sso_token",
    "LaunchCookieName": "agone_launch_token",
    "SessionCookieLifetime": "01:00:00",
    "CookieDomain": "",
    "CookieSameSite": "None",

    "// Behavior": "",
    "RefreshBufferMinutes": 5,
    "IsAgOneGateway": false,
    "AcceptTokenFromQueryString": true,
    "TokenQueryParameterName": "token",

    "// Paths that skip authentication": "",
    "AnonymousPaths": [
      "/api/health",
      "/api/public"
    ]
  }
}
