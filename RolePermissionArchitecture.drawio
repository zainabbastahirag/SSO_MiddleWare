<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Role Template Architecture" id="role-template">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="t1" value="AGOne Multi-Tenant Role &amp; Permission System" style="text;html=1;fontSize=26;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="700" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="Role Template Pattern — Tenants customize names, backend identifies by SystemCode" style="text;html=1;fontSize=14;align=center;fillColor=none;strokeColor=none;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="500" y="55" width="900" height="22" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SECTION 1: ROLE TEMPLATES (Platform-defined blueprints)        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="tmpl-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="2320" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="tmpl-title" value="ROLE TEMPLATES (Platform-Level — Defined by AGOne, Immutable by Tenants)" style="text;html=1;fontSize=17;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="700" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="tmpl-desc" value="&lt;font style='font-size:12px'&gt;Each template has a &lt;b&gt;SystemCode&lt;/b&gt; (never changes) + default permissions.&lt;br&gt;Tenants create instances from these templates. They can rename the role but the SystemCode stays.&lt;br&gt;Backend always checks &lt;b&gt;SystemCode&lt;/b&gt;, never the display name.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#fde68a;align=left;spacingLeft=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="700" height="65" as="geometry"/>
        </mxCell>

        <!-- Platform role templates -->
        <mxCell id="tmpl-plat-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#93c5fd;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="520" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="tmpl-plat-title" value="Platform Role Templates (ProductId = NULL)" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="70" y="225" width="400" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="tpl1" value="&lt;b&gt;TENANT_ADMIN&lt;/b&gt; 🔒&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Default name: &quot;Tenant Admin&quot;&lt;br&gt;Full tenant management access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="255" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="tpl2" value="&lt;b&gt;MANAGER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Default name: &quot;Manager&quot;&lt;br&gt;Team management, approvals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="tpl3" value="&lt;b&gt;EMPLOYEE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Default name: &quot;Employee&quot;&lt;br&gt;Basic self-service access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="385" width="230" height="55" as="geometry"/>
