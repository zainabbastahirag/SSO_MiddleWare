        <mxCell id="tb-th" value="&lt;table style='font-size:12px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#fef3c7;font-weight:bold'&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;Tenant Display Name&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;SystemCode&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;Product&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;IsDefault&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Tenant Admin&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;TENANT_ADMIN&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#64748b'&gt;Platform&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Manager&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;MANAGER&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#64748b'&gt;Platform&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Employee&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;EMPLOYEE&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#64748b'&gt;Platform&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Compliance Officer&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;SAFE_COMPLIANCE&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#8b5cf6'&gt;AG ONE Safe&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#fde68a;arcSize=6;overflow=fill;" vertex="1" parent="1">
