          <mxGeometry x="40" y="470" width="2320" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="inst-title" value="TENANT ROLE INSTANCES (Each tenant customizes names — backend uses SystemCode)" style="text;html=1;fontSize=17;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#92400e;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="800" height="25" as="geometry"/>
        </mxCell>

        <!-- Tenant A -->
        <mxCell id="ta-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#f59e0b;arcSize=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="700" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="ta-title" value="Tenant A — Acme Corp (they renamed everything)" style="text;html=1;fontSize=14;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#92400e;" vertex="1" parent="1">
          <mxGeometry x="80" y="528" width="500" height="20" as="geometry"/>
        </mxCell>

        <!-- Tenant A table header -->
        <mxCell id="ta-th" value="&lt;table style='font-size:12px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#fef3c7;font-weight:bold'&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;Tenant Display Name&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;SystemCode (immutable)&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;Product&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;IsDefault&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Company Administrator&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;TENANT_ADMIN&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#64748b'&gt;Platform&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Department Head&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;MANAGER&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#64748b'&gt;Platform&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Staff Member&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;EMPLOYEE&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#64748b'&gt;Platform&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;People Operations Lead&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#dc2626'&gt;HR_OFFICER&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#8b5cf6'&gt;AG ONE Work&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;✅ Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;&lt;b&gt;Training Coordinator&lt;/b&gt; &lt;font color='#16a34a'&gt;(custom)&lt;/font&gt;&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;font-family:monospace;color:#059669'&gt;CUSTOM_TRAINING_COORD&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a;color:#8b5cf6'&gt;AG ONE Learn&lt;/td&gt;&lt;td style='padding:6px 10px;border:1px solid #fde68a'&gt;❌ No&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#fde68a;arcSize=6;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="80" y="555" width="660" height="240" as="geometry"/>
        </mxCell>

