        <mxCell id="tpl4" value="&lt;b&gt;PRODUCT_ADMIN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Default name: &quot;Product Admin&quot;&lt;br&gt;Admin for specific product&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="255" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="tpl5" value="&lt;b&gt;HR_OFFICER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748b'&gt;Default name: &quot;HR Officer&quot;&lt;br&gt;Employee data, leave, payroll&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="320" width="230" height="55" as="geometry"/>
