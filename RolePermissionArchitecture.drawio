        <mxCell id="token-box" value="&lt;b style='font-size:14px'&gt;JWT Token Claims&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;font-family:monospace'&gt;primary_role: TenantAdmin&lt;br&gt;role: [TenantAdmin, ProductAdmin, HR]&lt;br&gt;product_role: [AGOneWork:ProductAdmin, AGOneWork:HR]&lt;br&gt;permission: [users:manage, masterdata:manage,&lt;br&gt;  manage:settings, manage:billings,&lt;br&gt;  employees:read, employees:write, leave:manage]&lt;br&gt;tenant_id: guid-ccc&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontSize=12;arcSize=10;align=left;spacingLeft=12;" vertex="1" parent="1">
