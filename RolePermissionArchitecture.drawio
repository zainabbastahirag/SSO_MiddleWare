        <mxCell id="db-title" value="DATABASE SCHEMA" style="text;html=1;fontSize=17;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="870" width="300" height="25" as="geometry"/>
        </mxCell>

        <!-- RoleTemplate table -->
        <mxCell id="tbl-template" value="&lt;table style='font-size:11px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#dbeafe'&gt;&lt;td colspan='2' style='padding:8px;font-weight:bold;font-size:14px;border:1px solid #93c5fd'&gt;🔵 RoleTemplates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold'&gt;Id&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;PK, Guid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold;color:#dc2626'&gt;SystemCode&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;string, unique, immutable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;DefaultName&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;Description&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;string?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;ProductId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK?, null=platform&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;IsSystemRole&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;bool (can't delete)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#3b82f6;strokeWidth=2;arcSize=8;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="80" y="910" width="280" height="200" as="geometry"/>
        </mxCell>

        <!-- TenantRole table (the instance) -->
        <mxCell id="tbl-tenantrole" value="&lt;table style='font-size:11px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#fef3c7'&gt;&lt;td colspan='2' style='padding:8px;font-weight:bold;font-size:14px;border:1px solid #fde68a'&gt;🟡 Roles (Tenant Instance) ⭐&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold'&gt;Id&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;PK, Guid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold;color:#dc2626'&gt;RoleTemplateId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK? → RoleTemplates (null for custom)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold;color:#dc2626'&gt;SystemCode&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;copied from template or custom&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold;color:#16a34a'&gt;Name (editable!)&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;tenant's custom display name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;DisplayName&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;TenantId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK → Tenants&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;ProductId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK? → Products&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;IsDefault&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;bool (auto-created from template)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;IsCustom&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;bool (tenant created from scratch)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#f59e0b;strokeWidth=2;arcSize=8;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="420" y="900" width="360" height="310" as="geometry"/>
        </mxCell>

        <!-- UserRoles table -->
        <mxCell id="tbl-userrole2" value="&lt;table style='font-size:11px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#fef2f2'&gt;&lt;td colspan='2' style='padding:8px;font-weight:bold;font-size:14px;border:1px solid #fecaca'&gt;🔴 UserRoles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold'&gt;Id&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;UserId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK → Users&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;RoleId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK → Roles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;TenantId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK → Tenants&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;ProductId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK? → Products&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold;color:#dc2626'&gt;Priority&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;int (lower = higher)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#dc2626;strokeWidth=2;arcSize=8;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="840" y="910" width="280" height="220" as="geometry"/>
        </mxCell>

        <!-- RolePermissions -->
        <mxCell id="tbl-roleperm2" value="&lt;table style='font-size:11px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#f0fdf4'&gt;&lt;td colspan='2' style='padding:8px;font-weight:bold;font-size:14px;border:1px solid #86efac'&gt;🟢 RolePermissions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;RoleId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK → Roles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;PermissionId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK → Permissions&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#22c55e;strokeWidth=2;arcSize=8;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="1180" y="910" width="260" height="110" as="geometry"/>
        </mxCell>

        <!-- Permissions -->
        <mxCell id="tbl-perm2" value="&lt;table style='font-size:11px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#f0fdf4'&gt;&lt;td colspan='2' style='padding:8px;font-weight:bold;font-size:14px;border:1px solid #86efac'&gt;🟢 Permissions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0;font-weight:bold'&gt;Id&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;Name&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;unique (e.g. users:manage)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;ProductId&lt;/td&gt;&lt;td style='padding:5px 8px;border:1px solid #e2e8f0'&gt;FK? → Products&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#22c55e;strokeWidth=2;arcSize=8;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="1500" y="910" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- Arrows between tables -->
        <mxCell id="arr1" value="" style="endArrow=ERmany;startArrow=ERone;html=1;strokeWidth=2;strokeColor=#3b82f6;" edge="1" parent="1" source="tbl-template" target="tbl-tenantrole">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr2" value="" style="endArrow=ERmany;startArrow=ERone;html=1;strokeWidth=2;strokeColor=#f59e0b;" edge="1" parent="1" source="tbl-tenantrole" target="tbl-userrole2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr3" value="" style="endArrow=ERmany;startArrow=ERone;html=1;strokeWidth=2;strokeColor=#f59e0b;" edge="1" parent="1" source="tbl-tenantrole" target="tbl-roleperm2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr4" value="" style="endArrow=ERmany;startArrow=ERone;html=1;strokeWidth=2;strokeColor=#22c55e;" edge="1" parent="1" source="tbl-perm2" target="tbl-roleperm2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Flow explanation -->
        <mxCell id="flow-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1820" y="900" width="520" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="flow-title" value="HOW IT WORKS" style="text;html=1;fontSize=16;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="1840" y="910" width="200" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="flow-text" value="&lt;font style='font-size:12px'&gt;&lt;b&gt;1. Platform seeds RoleTemplates&lt;/b&gt;&lt;br&gt;   TENANT_ADMIN, MANAGER, EMPLOYEE, HR_OFFICER...&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Tenant onboards → auto-create Roles from templates&lt;/b&gt;&lt;br&gt;   Copy SystemCode + DefaultName → tenant's Roles table&lt;br&gt;   IsDefault = true, IsCustom = false&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Tenant admin renames roles in UI&lt;/b&gt;&lt;br&gt;   &quot;Manager&quot; → &quot;Department Head&quot;&lt;br&gt;   SystemCode stays MANAGER (never changes)&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Tenant admin creates custom roles&lt;/b&gt;&lt;br&gt;   RoleTemplateId = null, IsCustom = true&lt;br&gt;   SystemCode = CUSTOM_{tenant-chosen-code}&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Backend always uses SystemCode&lt;/b&gt;&lt;br&gt;   JWT claim: role = MANAGER (not &quot;Department Head&quot;)&lt;br&gt;   [Authorize(Roles = &quot;TENANT_ADMIN,MANAGER&quot;)]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=12;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1840" y="940" width="480" height="270" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
