@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject NavigationManager Navigation
@inject IAuthService AuthService

<div class="app-container">
    <!-- Sidebar -->
    <aside class="sidebar @(sidebarCollapsed ? "collapsed" : "")">
        <div class="sidebar-decoration"></div>
        <div class="sidebar-header">
            @if (!sidebarCollapsed)
            {
                <img src="/images/logo.png" alt="AG One Learn logo" width="180"/>
            }
            <button class="sidebar-toggle" @onclick="ToggleSidebar">
                @if (sidebarCollapsed)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                }
            </button>
        </div>

        <nav class="sidebar-nav">
            <!-- PERSONAL — visible to ALL roles -->
            <div class="nav-section-label">
                @if (!sidebarCollapsed) { <span>PERSONAL</span> }
            </div>

            <NavLink href="" class="nav-item" Match="NavLinkMatch.All">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg>
                <span class="nav-text">Dashboard</span>
            </NavLink>

            <NavLink href="my-learning" class="nav-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                <span class="nav-text">My Learning</span>
            </NavLink>

            <!-- MANAGEMENT — only for Reporting Manager / HR -->
            @if (_isManager)
            {
                <div class="nav-section-label">
                    @if (!sidebarCollapsed) { <span>MANAGEMENT</span> }
                </div>

                <NavLink href="content-source" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                    <span class="nav-text">Content Sources</span>
                </NavLink>

                <NavLink href="content-library" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>
                    <span class="nav-text">Content Library</span>
                </NavLink>

                <NavLink href="learning-path" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/><path d="M15 5.764v15"/><path d="M9 3.236v15"/></svg>
                    <span class="nav-text">Learning Path</span>
                </NavLink>

                <NavLink href="learning-assignment" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>
                    <span class="nav-text">Learning Assignment</span>
                </NavLink>

                <NavLink href="item-bank" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
                    <span class="nav-text">Item Bank</span>
                </NavLink>

                <NavLink href="assessment-policy" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
                    <span class="nav-text">Assessment Policy</span>
                </NavLink>

                <NavLink href="audit-log" class="nav-item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke:#e5e8f0;"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
                    <span class="nav-text">Audit Log</span>
                </NavLink>
            }
        </nav>

        <!-- User info at bottom -->
        <div class="sidebar-footer">
            @if (!sidebarCollapsed)
            {
                <div class="sidebar-user">
                    <div class="sidebar-user-avatar">@_initials</div>
                    <div class="sidebar-user-info">
                        <span class="sidebar-user-name">@_displayName</span>
                        <span class="sidebar-user-role">@_primaryRole</span>
                    </div>
                </div>
            }
            else
            {
                <div class="sidebar-user-avatar small" title="@_displayName — @_primaryRole">@_initials</div>
            }
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <img src="https://via.placeholder.com/150x36?text=Client+Logo" alt="Client Logo" class="header-logo" />
                <div class="header-divider"></div>
                <span class="header-title">AG ONE Learn</span>
            </div>

            <div class="header-right">
                <button class="header-icon-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </button>

                <button class="header-icon-btn" style="position:relative;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    <span style="position:absolute;top:2px;right:2px;width:8px;height:8px;background:var(--error);border-radius:50%;"></span>
                </button>

                <div class="avatar" title="@_displayName">@_initials</div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="main-area">
            @Body
        </main>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool sidebarCollapsed = false;

    private bool _isManager = false;
    private string _displayName = "";
    private string _initials = "";
    private string _primaryRole = "";
    private List<string> _roles = new();

    private static readonly HashSet<string> ManagerRoles = new(StringComparer.OrdinalIgnoreCase)
    {
        "Reporting Manager",
        "HR",
        "Admin",
        "TenantAdmin",
        "ProductAdmin"
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask == null) return;

        var authState = await AuthStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var name = user.FindFirst("name")?.Value
                    ?? user.FindFirst(ClaimTypes.Name)?.Value
                    ?? user.FindFirst("preferred_username")?.Value
                    ?? "";
            var email = user.FindFirst(ClaimTypes.Email)?.Value
                     ?? user.FindFirst("email")?.Value
                     ?? "";

            _displayName = !string.IsNullOrEmpty(name) ? name : email;

            var parts = _displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            _initials = parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
                : _displayName.Length > 0 ? _displayName[0].ToString().ToUpper() : "?";

            _roles = user.FindAll(ClaimTypes.Role)
                .Concat(user.FindAll("roles"))
                .Concat(user.FindAll("http://schemas.microsoft.com/ws/2008/06/identity/claims/role"))
                .Select(c => c.Value)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            _primaryRole = _roles.FirstOrDefault() ?? "Employee";
            _isManager = _roles.Any(r => ManagerRoles.Contains(r));
        }
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }
}

<style>
    .nav-section-label {
        padding: 16px 24px 8px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        color: rgba(148, 163, 184, 0.7);
        text-transform: uppercase;
    }
    .collapsed .nav-section-label {
        padding: 12px 0;
        text-align: center;
    }
    .collapsed .nav-section-label span { display: none; }
    .collapsed .nav-section-label::after {
        content: '';
        display: block;
        width: 20px;
        height: 1px;
        background: rgba(148, 163, 184, 0.3);
        margin: 0 auto;
    }

    .sidebar-footer {
        margin-top: auto;
        padding: 16px;
        border-top: 1px solid rgba(255,255,255,0.08);
    }
    .sidebar-user {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .sidebar-user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: linear-gradient(135deg, #3B82F6, #8B5CF6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 13px;
        flex-shrink: 0;
    }
    .sidebar-user-avatar.small {
        width: 32px;
        height: 32px;
        font-size: 12px;
        margin: 0 auto;
    }
    .sidebar-user-info {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .sidebar-user-name {
        font-size: 13px;
        font-weight: 600;
        color: #E2E8F0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .sidebar-user-role {
        font-size: 11px;
        color: #94A3B8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sidebar-nav {
        flex: 1;
        overflow-y: auto;
    }
    .sidebar {
        display: flex;
        flex-direction: column;
    }
</style>
